# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# These are read only by the local server (Vite's Node process). They are not
# VITE_-prefixed, so they are never included in the browser bundle.
#
# Prototype rule: use only synthetic customer data and public knowledge sources.
# Content sent on the Gemini API free tier may be used by Google to improve its products.

# Gemini API key from Google AI Studio: https://aistudio.google.com/app/apikey
# To stay on the free tier, use a key from a Google Cloud project without billing enabled.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Model for Sunny's conversation. Optional; defaults to gemini-3.5-flash-lite
# (stable, listed with a Gemini API free tier on Google's pricing page, checked 2026-10-21).
# gemini-3.8-flash is also free-tier; switch if it isn't reporting high demand.
GEMINI_MODEL=gemini-3.5-flash-lite
